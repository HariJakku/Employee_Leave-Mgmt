            "url": {
              "raw": "{{baseUrl}}/api/employees?page=0&size=10&search=&status=ACTIVE",
              "host": ["{{baseUrl}}"],
              "path": ["api", "employees"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "search", "value": "" },
                { "key": "status", "value": "ACTIVE" }
              ]
            }
          }
        },
        {
